generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  name               String?
  passwordHash       String
  role               String    @default("MEMBER") // ADMIN, BOARD, MEMBER
  position           String? // Presidente, Tesorero, etc.
  isBoardMember      Boolean   @default(false)
  mustChangePassword Boolean   @default(false)
  resetToken         String?   @unique
  resetTokenExpires  DateTime?
  firstLoginAt       DateTime?
  lastLoginAt        DateTime?
  loginCount         Int       @default(0)
  member             Member?

  // Track registrations recorded by this user
  recordedRegistrations EventRegistration[] @relation("RecordedBy")
  recordedFees          MembershipFee[]     @relation("FeeRecordedBy")
  buffetSalesRecorded   BuffetSale[]        @relation("BuffetRecordedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Member {
  id           String    @id @default(uuid())
  memberNumber String
  firstName    String
  lastName     String
  dni          String    @unique
  address      String?
  city         String?
  email        String?
  phone        String?
  joinDate     DateTime  @default(now())
  honoraryAppointmentDate DateTime?
  honoraryReason          String?
  honorarySummary         String?
  birthDate    DateTime?
  type         String    @default("ACTIVO") // ACTIVO, HONORARIO
    status       String    @default("ACTIVE") // ACTIVE, BAJA, plus legacy values during migration
    bajaReason   String?   // RENUNCIA, FALLECIMIENTO
    debtStatus   String?   // AL DIA, EN MORA, SUSPENDIDO

  // Board status
  isBoardMember Boolean @default(false)
  position      String? // e.g. "Vocal", "Presidente"

  // New: Family Discount (50%)
  isFamilyDiscount Boolean  @default(false)
  partnerId        String?
  partner          Member?  @relation("MemberPartner", fields: [partnerId], references: [id])
  partnerOf        Member[] @relation("MemberPartner")

  wantsMailing Boolean @default(true)
  notes        String?
  userId       String? @unique
  user         User?   @relation(fields: [userId], references: [id])

  fees                MembershipFee[]
  communications      Communication[]
  novedadMailings     NovedadMailing[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  avatarUrl           String? // For digital ID
  deactivatedAt       DateTime?
  eventRegistrations  EventRegistration[]
  championshipResults ChampionshipResult[] @relation("MemberAwards")
  honoraryAchievements HonoraryAchievement[]
  boardHistory        BoardHistory[]
  buffetPurchases     BuffetSale[]         @relation("BuffetBuyer")
}

model HonoraryAchievement {
  id          String   @id @default(uuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  title       String
  description String?
  eventDate   DateTime?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([memberId, sortOrder])
}

model Communication {
  id       String   @id @default(uuid())
  memberId String
  member   Member   @relation(fields: [memberId], references: [id])
  type     String // WELCOME, DEBT_REMINDER, EVENT_INFO, GENERAL
  subject  String
  content  String
  sentBy   String?
  sentAt   DateTime @default(now())
  status   String   @default("SENT") // SENT, FAILED, PENDING
  channel  String   @default("EMAIL") // EMAIL, WHATSAPP, MANUAL

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MembershipFee {
  id            String   @id @default(uuid())
  memberId      String
  member        Member   @relation(fields: [memberId], references: [id])
  periodYear    Int
  periodMonth   Int
  amountDue     Float
  amountPaid    Float
  paymentDate   DateTime  // Fecha de REGISTRO en el sistema
  realPaymentDate DateTime? // Fecha REAL en que ocurrió el pago (null = igual a paymentDate)
  paymentMethod String?
  paymentStatus String // PAID, PARTIAL
  notes         String?

  // Track recording user for fees too
  recordedById String?
  recordedBy   User?   @relation("FeeRecordedBy", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, periodYear, periodMonth])
}

model Announcement {
  id          String    @id @default(uuid())
  title       String
  content     String
  status      String    @default("DRAFT")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Novedad {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  subtitle    String?
  content     String
  imageUrl    String?
  publishedAt DateTime  @default(now())
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  attachments NovedadAttachment[]
  mailings    NovedadMailing[]
}

model NovedadAttachment {
  id           String   @id @default(uuid())
  novedadId    String
  novedad      Novedad  @relation(fields: [novedadId], references: [id], onDelete: Cascade)
  fileName     String
  storageName  String
  fileMimeType String
  fileData     Bytes
  createdAt    DateTime @default(now())

  @@index([novedadId])
}

model NovedadMailing {
  id         String   @id @default(uuid())
  novedadId  String
  novedad    Novedad  @relation(fields: [novedadId], references: [id], onDelete: Cascade)
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status     String   @default("PENDING")
  sentAt     DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([novedadId, memberId])
  @@index([novedadId, status])
}


model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Teacher {
  id     String  @id @default(uuid())
  name   String
  bio    String?
  events Event[] @relation("EventTeachers")
}

model Event {
  id          String    @id @default(uuid())
  slug        String?   @unique
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?
  location    String?   @default("Sede Central CAT")
  type        String    @default("MILONGA") // MILONGA, OTRO

  // Modular Event Toggles
  hasClasses     Boolean   @default(false)
  hasMilonga     Boolean   @default(true)
  isRecurring    Boolean   @default(false)
  recurrenceDay  Int?      // 0: Domingo, 1: Lunes, 2: Martes, 3: Miércoles, 4: Jueves, 5: Viernes, 6: Sábado
  recurrenceTime String?   // e.g. "20:00"

  // Specific Schedules and Locations
  milongaStart    DateTime?
  milongaEnd      DateTime?
  milongaEndTime  String?   // e.g. "03:00"
  milongaLocation String?
  milongaMapsUrl  String?   // Google Maps direction link
  tangoDJ         String?

  organizer    String  @default("Centro Amigos del Tango")
  contactPhone String? // WhatsApp / Telefono de contacto
  contactEmail String? // Email de contacto
  notificationEmails String? // Correos adicionales para notificaciones de este evento

  // Pricing - Milonga
  priceSocioMilonga        Float?
  priceNonSocioMilonga     Float?

  // Pricing - Venta Anticipada (Early Bird)
  hasEarlyBird                Boolean   @default(false)
  earlyBirdDeadline           DateTime?
  priceSocioEarlyBird         Float?
  priceNonSocioEarlyBird      Float?
  priceSocioComboEarlyBird    Float?
  priceNonSocioComboEarlyBird Float?

  // Pricing - Capacitaciones / Clases
  comboTitle              String?  @default("Combo Clases")
  priceSocioCombo         Float?
  priceNonSocioCombo      Float?
  priceSocioClassLoose    Float?
  priceNonSocioClassLoose Float?

  status      String  @default("OPEN") // OPEN, CLOSED, ARCHIVED
  isPublic    Boolean @default(true) // For website visibility
  isFree      Boolean @default(false) // Evento 100% gratuito
  sendAttendeeConfirmation Boolean @default(true) // Enviar email confirmatorio automatico al asistente
  eventBanner String? // URL/Path to designed banner image

  teachers      Teacher[]           @relation("EventTeachers")
  classes       EventClass[]
  registrations EventRegistration[]
  buffetSales   BuffetSale[]
  buffetCashRegister BuffetCashRegister?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventClass {
  id          String    @id @default(uuid())
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title       String
  description String?
  classDate   DateTime?
  startTime   String?   // e.g. "15:00"
  endTime     String?   // e.g. "16:15"
  order       Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model EventRegistration {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  // Link to member if exists, otherwise manual data
  memberId String?
  member   Member? @relation(fields: [memberId], references: [id])

  firstName String
  lastName  String
  dni       String?
  email     String?
  phone     String?

  registrationType String @default("MILONGA") // MILONGA
  selectedClassIds String[] @default([]) // Clases sueltas elegidas dentro del temario
  amountPaid       Float   @default(0)
  paymentStatus    String  @default("PENDING") // PENDING, PAID
  paymentMethod    String? // CASH, TRANSFER, etc
  paymentProof     String? // URL/Path to image
  realPaymentDate  DateTime? // Fecha REAL en que ocurrió el pago (null = usa createdAt)

  // Asistencia a la milonga
  attended         Boolean   @default(false)
  attendedAt       DateTime?

  // Source tracking
  source       String  @default("MANAGEMENT") // WEB, MANAGEMENT
  recordedById String?
  recordedBy   User?   @relation("RecordedBy", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BuffetCashRegister {
  id             String   @id @default(uuid())
  eventId        String   @unique
  event          Event    @relation(fields: [eventId], references: [id])
  openingBalance Float    @default(0)
  closingBalance Float?
  observations   String?
  status         String   @default("OPEN") // OPEN, CLOSED
  closedAt       DateTime?
  withdrawals    BuffetCashWithdrawal[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model BuffetCashWithdrawal {
  id          String   @id @default(uuid())
  registerId  String
  register    BuffetCashRegister @relation(fields: [registerId], references: [id])
  amount      Float
  reason      String
  createdAt   DateTime @default(now())
}

model Championship {
  id          String               @id @default(uuid())
  year        Int
  name        String               @default("Vientos de Tango")
  description String? // Optional description of this championship edition
  results     ChampionshipResult[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([year, name])
}

model ChampionshipResult {
  id             String       @id @default(uuid())
  championshipId String
  championship   Championship @relation(fields: [championshipId], references: [id])

  category String // TANGO PISTA, MILONGA, VALS, TANGO ESCENARIO
  place    Int // 1, 2, 3

  // Link to member if they are a current member
  memberId String?
  member   Member? @relation("MemberAwards", fields: [memberId], references: [id])

  // Names of the couple (since one or both might not be members)
  firstName   String
  lastName    String
  partnerName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BoardHistory {
  id          String   @id @default(uuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id])
  position    String // e.g. "Presidente", "Vocal"
  periodStart String? // e.g. "2012"
  periodEnd   String? // e.g. "2023"
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BuffetProduct {
  id        String   @id @default(uuid())
  name      String
  brand     String?
  size      String?
  price     Float
  type      String // BEBIDAS_SIN_ALCOHOL, BEBIDAS_CON_ALCOHOL, COMIDA
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  saleItems BuffetSaleItem[]
}

model BuffetSale {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  amountTotal   Float
  amountPaid    Float
  paymentMethod String // CASH, TRANSFER, MERCADOPAGO, A_COBRAR

  buyerName String?
  buyerId   String?
  buyer     Member? @relation("BuffetBuyer", fields: [buyerId], references: [id])

  recordedById String?
  recordedBy   User?   @relation("BuffetRecordedBy", fields: [recordedById], references: [id])

  items BuffetSaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BuffetSaleItem {
  id          String        @id @default(uuid())
  saleId      String
  sale        BuffetSale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  product     BuffetProduct @relation(fields: [productId], references: [id])
  quantity    Int
  priceAtSale Float

  @@unique([saleId, productId])
}

model EscuelitaStudent {
  id          String                @id @default(uuid())
  dni         String                @unique
  firstName   String
  lastName    String
  email       String?
  phone       String?
  attendances EscuelitaAttendance[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model EscuelitaClass {
  id          String                @id @default(uuid())
  date        DateTime              @default(now())
  teachers    String // Nombres de los profesores
  photoUrl    String?
  attendances EscuelitaAttendance[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model EscuelitaAttendance {
  id        String           @id @default(uuid())
  studentId String
  classId   String
  student   EscuelitaStudent @relation(fields: [studentId], references: [id])
  escuelita EscuelitaClass   @relation(fields: [classId], references: [id])
  createdAt DateTime         @default(now())

  @@unique([studentId, classId])
}

// ============================================
// JUEGOS — Acertijo 2.0
// ============================================

model TriviaQuestion {
  id            String   @id @default(uuid())
  statement     String   // Enunciado de la pregunta
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption String   // "A", "B", "C", "D"
  category      String   // historia, orquestas, cantantes, etc.
  difficulty    String   @default("MEDIUM") // EASY, MEDIUM, HARD
  isActive      Boolean  @default(true)
  answers       TriviaAnswer[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TriviaGame {
  id               String         @id @default(uuid())
  name             String         @default("Acertijo 2.0")
  isActive         Boolean        @default(false)
  
  // -- Campos para Juego en Vivo --
  status           String         @default("IDLE") // IDLE, WAITING_FOR_START, QUESTION_HIDDEN, TIMER_ACTIVE, PAUSED, GAME_OVER, SHOWING_RESULTS
  currentQuestionId String?       
  currentQuestionIndex Int          @default(0)
  timerDuration    Int            @default(10)     // Segundos ajustables
  timerEndAt       DateTime?                        // Para sincronizar el reloj
  pausedTimeRemaining Int?                         // Segundos que faltaban al pausar
  activeQuestionIds String[]      @default([])     // Las 10 preguntas elegidas para la sesión
  // -------------------------------

  questionsEasy    Int            @default(5)
  questionsMedium  Int            @default(5)
  questionsHard    Int            @default(5)
  timeEasy         Int            @default(10) // Segundos
  timeMedium       Int            @default(12)
  timeHard         Int            @default(15)
  totalTimeLimit   Int?           // Segundos globales, null = sin límite
  pointsCorrect    Int            @default(10)
  pointsIncorrect  Int            @default(0) // Penalización
  sessions         TriviaSession[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model TriviaPlayer {
  id        String          @id @default(uuid())
  firstName String
  lastName  String
  nickname  String?
  email     String?
  phone     String?
  sessions  TriviaSession[]
  createdAt DateTime        @default(now())
}

model TriviaSession {
  id             String        @id @default(uuid())
  playerId       String
  player         TriviaPlayer  @relation(fields: [playerId], references: [id])
  gameId         String
  game           TriviaGame    @relation(fields: [gameId], references: [id])
  totalCorrect   Int           @default(0)
  totalIncorrect Int           @default(0)
  totalTime      Int           @default(0) // Milisegundos
  score          Int           @default(0)
  completedAt    DateTime?
  answers        TriviaAnswer[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
}

model TriviaAnswer {
  id             String         @id @default(uuid())
  sessionId      String
  session        TriviaSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId     String
  question       TriviaQuestion @relation(fields: [questionId], references: [id])
  selectedOption String         // "A", "B", "C", "D"
  isCorrect      Boolean
  timeTaken      Int            // Milisegundos
  createdAt      DateTime       @default(now())

  @@unique([sessionId, questionId])
}

model EnrollmentRequest {
  id              String   @id @default(uuid())
  firstName       String
  lastName        String
  email           String
  phone           String
  dni             String
  birthDate       DateTime
  address         String
  comment         String?
  paymentProofUrl String
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LocalTangoTeacher {
  id        String            @id @default(uuid())
  fullName  String
  photoUrl  String?
  bio       String?
  phone     String?
  email     String?
  instagram String?
  city      String            @default("Comodoro Rivadavia")
  isActive  Boolean           @default(true)
  classes   LocalTangoClass[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model LocalTangoClass {
  id              String             @id @default(uuid())
  title           String?
  teacherName     String
  group           String?            // e.g. Escuelita del CAT, Comodoro Tango, Garufa
  teacherId       String?
  teacher         LocalTangoTeacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  city            String             @default("Comodoro Rivadavia") // Comodoro Rivadavia, Rada Tilly
  neighborhood    String?            // e.g. Centro, Industrial, Roca, KM5
  locationName    String             // e.g. Centro Cultural Comodoro, Biblioteca Publica CIP
  address         String             // e.g. Hipólito Yrigoyen 99
  schedule        String             // e.g. Martes de 20 a 22 hs.
  contactInfo     String?            // e.g. 297-5025462
  priceType       String             @default("ARANCELADO") // GRATIS, ARANCELADO, CONSULTAR
  priceDetails    String?
  registrationUrl String?
  notes           String?            // Observaciones / Comentarios adicionales
  isPublished     Boolean            @default(true)
  order           Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model MemberBenefit {
  id          String   @id @default(uuid())
  title       String
  description String
  badge       String?  // e.g. DESCUENTO, ACCESO GRATUITO, CONVENIO
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MemberCommunication {
  id           String   @id @default(uuid())
  title        String
  description  String
  fileUrl      String
  storageName  String
  fileData     Bytes?
  fileName     String
  fileMimeType String
  status       String   @default("DRAFT") // DRAFT, PUBLISHED
  publishedAt  DateTime?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, publishedAt])
}

